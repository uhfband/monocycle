{
    "name": "uhf/monocycle",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Uhf\\Monocycle\\": "src/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/BaseTest.php"
        ]
    },
    "require": {
        "php": ">=7.4",
        "ext-json": "*",
        "ext-sockets": "*",
        "dragonmantank/cron-expression": "^3.4",
        "monolog/monolog": "^2.11",
        "gfaugere/monolog-colored-line": "^1.0",
        "symfony/http-foundation": "^5.4"
    },
    "bin": [
        "bin/http_server",
        "bin/db_worker_sqlite",
        "bin/db_worker_mysql"
    ],
    "suggest": {
        "ext-sqlite3": "Required by bin/db_worker_sqlite (Database\\SQLite\\Connection::open())",
        "ext-mysqli": "Required by bin/db_worker_mysql (Database\\MySQL\\Connection::open())"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "ext-curl": "*",
        "ext-mbstring": "*"
    }
}
